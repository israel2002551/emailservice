# Copy this file to .env for local testing. Never commit .env.
# On Render, set the same keys under the service's Environment tab (without quotes).

# SendGrid API key with Mail Send access (SendGrid: Settings > API Keys).
SENDGRID_API_KEY=SG.replace-with-your-key

# Who the emails come from. SendGrid only sends from a verified sender
# (SendGrid: Settings > Sender Authentication).
EMAIL_FROM="BUYSELL Nigeria <info@buysell-marketplace.com>"

# Shared secret that callers send as "Authorization: Bearer <secret>".
# At least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The send-broadcast Supabase function needs the same value in its secrets.
EMAIL_SERVICE_SECRET=replace-with-a-long-random-string-of-32-or-more-characters

# Render sets PORT itself. Locally the service uses 3000 when this is empty.
PORT=3000
